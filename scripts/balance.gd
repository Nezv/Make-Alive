class_name Balance
## The balance sheet: what the numbers in weapons.gd and Zombie.STATS add up to.
## `tools\balance.ps1` prints it and writes references/balance.md; tests/test_balance.gd holds the
## rules it must keep. Tune by this table, not by feel.
##
## Assumes every bullet (and every pellet) lands on the named part: the best case at close range.

const PARTS := { "head": Humanoid.Part.HEAD, "torso": Humanoid.Part.TORSO, "legs": Humanoid.Part.LEG_L }
const TORSO_HALF_WIDTH := 0.25 ## metres: a shot that strays further than this misses the chest


## Hit points one trigger pull takes off a zombie's body when it lands on `part` (as Zombie.take_hit does).
static func damage_per_shot(gun: int, part: int) -> int:
	var d := Weapons.def(gun)
	var per_pellet := float(d.damage)
	if part == Humanoid.Part.HEAD:
		per_pellet *= Config.HEAD_MULT
	elif part != Humanoid.Part.TORSO:
		per_pellet *= Config.LIMB_BODY_MULT
	var pellets: int = d.pellets
	return int(per_pellet) * pellets


static func shots_to_kill(gun: int, zombie_type: int, part: int) -> int:
	var hp: int = Zombie.STATS[zombie_type][2]
	return ceili(float(hp) / maxi(damage_per_shot(gun, part), 1))


## Seconds to put every round back: one magazine swap, or one shell at a time.
static func full_reload(gun: int) -> float:
	var d := Weapons.def(gun)
	var reload: float = d.reload
	var mag: int = d.mag
	return reload * mag if d.reload_style == Weapons.Reload.SHELLS else reload


## Seconds from the first shot to the `shots`-th, starting with a full magazine.
static func seconds_for_shots(gun: int, shots: int) -> float:
	var d := Weapons.def(gun)
	var interval: float = d.interval
	var mag: int = d.mag
	var reloads := (shots - 1) / mag
	# A reload replaces the wait for the next round, so the last shot before it costs no interval.
	return (shots - 1 - reloads) * interval + reloads * (full_reload(gun) + interval)


static func seconds_to_kill(gun: int, zombie_type: int, part: int) -> float:
	return seconds_for_shots(gun, shots_to_kill(gun, zombie_type, part))


static func damage_per_magazine(gun: int) -> int:
	var d := Weapons.def(gun)
	var mag: int = d.mag
	return damage_per_shot(gun, Humanoid.Part.TORSO) * mag


## Torso damage per second while the magazine lasts.
static func burst_dps(gun: int) -> float:
	var interval: float = Weapons.def(gun).interval
	return damage_per_shot(gun, Humanoid.Part.TORSO) / interval


## Torso damage per second over a whole magazine and the reload after it.
static func sustained_dps(gun: int) -> float:
	var d := Weapons.def(gun)
	var interval: float = d.interval
	var mag: int = d.mag
	return damage_per_magazine(gun) / (mag * interval + full_reload(gun))


static func kills_per_magazine(gun: int, zombie_type: int, part: int) -> int:
	var mag: int = Weapons.def(gun).mag
	return mag / shots_to_kill(gun, zombie_type, part)


## Metres at which an aimed shot (or a shotgun's pattern) still stays on a chest.
static func effective_range(gun: int) -> float:
	var d := Weapons.def(gun)
	var cone: float = d.ads_spread
	var pattern: float = d.pellet_spread
	var reach: float = d.range
	var angle := cone + pattern
	return reach if angle <= 0.0 else minf(reach, TORSO_HALF_WIDTH / tan(angle))


## The whole sheet as Markdown.
static func sheet() -> String:
	var out := "# Balance sheet\n\nGenerated by `tools\\balance.ps1` from `scripts/weapons.gd` and `Zombie.STATS`. Don't edit by hand.\n"
	out += "Every shot is assumed to land on the named part. `shots / seconds` to kill, reloads included.\n\n"
	out += "## Guns\n\n| Gun | Dmg / shot | Burst DPS | Sustained DPS | Dmg / mag | Full reload (s) | Effective range (m) |\n|---|---|---|---|---|---|---|\n"
	for gun in Weapons.COUNT:
		out += "| %s | %d | %.0f | %.0f | %d | %.1f | %.0f |\n" % [Weapons.def(gun).name,
			damage_per_shot(gun, Humanoid.Part.TORSO), burst_dps(gun), sustained_dps(gun),
			damage_per_magazine(gun), full_reload(gun), effective_range(gun)]
	for type_name: String in Zombie.Type.keys():
		var type: int = Zombie.Type[type_name]
		out += "\n## %s (%d HP)\n\n| Gun | Head | Torso | Legs | Kills / mag (torso) |\n|---|---|---|---|---|\n" % [
			type_name.capitalize(), Zombie.STATS[type][2]]
		for gun in Weapons.COUNT:
			var cells := []
			for part_name: String in PARTS:
				var part: int = PARTS[part_name]
				cells.append("%d / %.2f s" % [shots_to_kill(gun, type, part), seconds_to_kill(gun, type, part)])
			out += "| %s | %s | %s | %s | %d |\n" % [Weapons.def(gun).name, cells[0], cells[1], cells[2],
				kills_per_magazine(gun, type, Humanoid.Part.TORSO)]
	return out
